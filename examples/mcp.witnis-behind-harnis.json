{
  "mcpServers": {
    "witnis": {
      "command": "npx",
      "args": [
        "-y",
        "harnis",
        "mcp",
        "--preset",
        "coding-agent",
        "--policy",
        ".harnis/policy.json",
        "--",
        "witnis",
        "mcp"
      ],
      "env": {
        "WITNIS_DB": "REPLACE_WITH_ABSOLUTE_PATH_TO/.witnis/index.sqlite"
      }
    }
  }
}
